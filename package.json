{
  "name": "shadowshield",
  "version": "0.2.0",
  "description": "Detects and reports browser fingerprinting activity (MV3, Firefox-first).",
  "private": true,
  "type": "module",
  "scripts": {
    "build":   "node scripts/build.mjs",
    "dev":     "node scripts/build.mjs --dev",
    "lint":    "eslint src/ && web-ext lint --source-dir=dist/ --warnings-as-errors",
    "lint:src": "eslint src/",
    "format":  "prettier --write \"src/**/*.{js,json,html,css}\"",
    "test":    "echo \"No unit tests yet – see tests/pages/ for manual test pages\" && exit 0",
    "package": "npm run build && web-ext build --source-dir=dist/ --artifacts-dir=artifacts/"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "web-ext": "^8.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
