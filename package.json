{
  "name": "shadowshield",
  "version": "0.2.0",
  "description": "Detects and reports browser fingerprinting activity (MV3, Firefox-first).",
  "private": true,
  "type": "module",
  "scripts": {
    "build":   "node scripts/build.mjs",
    "build:rules": "node scripts/build-rules.mjs",
    "check-url": "node scripts/check-url.mjs",
    "dev":     "node scripts/build.mjs --dev",
    "lint": "npm run build && eslint src/ && web-ext lint --source-dir=dist/ --warnings-as-errors --ignore-files \"rules/*.json\"",
    "lint:src": "eslint src/",
    "format":  "prettier --write \"src/**/*.{js,json,html,css}\"",
    "test":    "node --test tests/unit/*.test.mjs",
    "test:pages": "node scripts/serve-test-pages.mjs",
    "verify": "node scripts/verify.mjs",
    "package": "npm run build && web-ext build --source-dir=dist/ --artifacts-dir=artifacts/"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "web-ext": "^8.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
