{
    "manifest_version": 3,
    "name": "ShadowShield",
    "version": "0.1.0",
    "description": "Detects browser fingerprinting activity.",
    "permissions": [
        "tabs"
    ],
    "background": {
        "scripts": [
            "background.js"
        ],
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup/popup.html"
    },
   "content_scripts": [
    {
        "matches": ["<all_urls>"],
        "js": ["injection.js"],
        "run_at": "document_start",
        "world": "MAIN"
    },
    {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "run_at": "document_start"
    }
]
}